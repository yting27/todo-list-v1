{
  "name": "@todo/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./generated": {
      "types": "./src/generated.ts",
      "default": "./dist/generated.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "generate": "openapi-typescript ../../api/openapi.yaml -o src/generated.ts",
    "test": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.2"
  }
}
