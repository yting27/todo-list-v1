# Safe local-development defaults. Replace every secret outside local development.
POSTGRES_DB=todo
POSTGRES_USER=user0
POSTGRES_PASSWORD=todo_local_password
DATABASE_URL=postgres://todo:todo_local_password@postgres:5432/todo
REDIS_URL=redis://redis:6379
API_PORT=8080
LOG_LEVEL=info
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=900
VITE_API_BASE_URL=
